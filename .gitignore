# Dependencies: restore with `composer install`, `npm ci` and `npm run vendor`
vendor/
node_modules/

# Local secrets (copy functions/config.example.php)
functions/config.php

# User-uploaded photos are runtime data, never commit them
uploads/*
!uploads/.gitkeep

# Generated knowledge graph
graphify-out/

# Spreadsheets uploaded for import are runtime data
functions/system/process/*.xlsx
functions/system/process/*.xls
functions/system/process/*.csv

# Identity vault (encrypted selfies and ID images) and local logs: runtime data
storage/vault/*
!storage/vault/.gitkeep
storage/logs/*
!storage/logs/.gitkeep
